<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only proxy inspection for optional network features. Release uses
     the main resource and trusts only system certificates. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
