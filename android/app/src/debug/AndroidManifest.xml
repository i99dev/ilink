<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG-ONLY: adb-driven E2E trigger for the cluster patcher. Absent
         from release. Exported so `am broadcast` from the shell uid reaches
         it. See clusterpatch/ClusterPatchDebugReceiver. -->
    <application>
        <receiver
            android:name=".clusterpatch.ClusterPatchDebugReceiver"
            android:exported="true" />
    </application>
</manifest>
