<?xml version="1.0" encoding="utf-8"?>
<!--
  Heartbeat-only sibling to a11y_remote_control. No gestures, no
  retrieve-window-content. Just enough config for Android to bind the
  service so its onServiceConnected fires and we can detect
  "BYD's a11y panel forgot us" via the asymmetric-state heuristic.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_watchdog_description"
    android:notificationTimeout="500"
    android:summary="@string/a11y_watchdog_summary"/>
