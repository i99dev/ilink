# Find-car welcome flash. On-car probing (2026-05-31) showed this car
# REJECTS LIGHTS_FLASHING_LIGHT_AND_HORN (code -2147482648) but ACCEPTS
# LIGHTS_FIND_CAR_WELCOME_SWITCH_SET=1324634174 (code 0). Was a broken
# unit_action (set lturn 1 — a stuck left blinker); now the same direct
# fast_action path as door.lock.
fast_actions {
  action_id: "light.flash"
  device_type: 1001  # DT_BODY
  feature_name: "Light.LIGHTS_FIND_CAR_WELCOME_SWITCH_SET"
  value {
    constant: 1
  }
}

