# Public offline dispatch data; packaged under the APK signature.
# Schema: proto/car_table.proto. See docs/offline-first/local-command-tables.md.

version: "1.0.0"

fast_actions {
  action_id: "door.lock"
  device_type: 1001  # DT_BODY
  feature_name: "Bodywork.BODYWORK_FOUR_DOOR_SET"
  value {
    constant: 2
  }
}

