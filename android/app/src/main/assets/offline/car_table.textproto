# INSTRUMENT_HEADLIGHT_CONTROL_SET is a 4-value enum from BYD's own
# CarExternalLightServiceImpl.setHeadlightMode: 1=HIGH, 2=AUTO, 3=ON, 4=OFF.
fast_actions {
  action_id: "light.head"
  device_type: 1001  # DT_BODY
  feature_name: "Instrument.INSTRUMENT_HEADLIGHT_CONTROL_SET"
  value {
    arg_bool {
      arg_name: "on"
      on_value: 3
      off_value: 4
    }
  }
}

fast_actions {
  action_id: "light.head.on"
  device_type: 1001  # DT_BODY
  feature_name: "Instrument.INSTRUMENT_HEADLIGHT_CONTROL_SET"
  value {
    constant: 3
  }
}

fast_actions {
  action_id: "light.head.off"
  device_type: 1001  # DT_BODY
  feature_name: "Instrument.INSTRUMENT_HEADLIGHT_CONTROL_SET"
  value {
    constant: 4
  }
}

